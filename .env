  <!-- TOPO JS/ LOGO ABAIXO -->

  window.sorteado = JSON.parse(localStorage.getItem("sorteado")) || null;

function sortearNumero() {

  if (window.sorteado) {
    alert("Sorteio já realizado: " + window.sorteado);
    return;
  }

  // pega só números não comprados
  const disponiveis = [];

  document.querySelectorAll(".numero").forEach(btn => {

    const num = btn.textContent;

    if (!btn.disabled) {
      disponiveis.push(num);
    }

  });

  if (disponiveis.length === 0) {
    alert("Nenhum número disponível!");
    return;
  }

  // sorteio aleatório
  const vencedor = disponiveis[Math.floor(Math.random() * disponiveis.length)];

  window.sorteado = vencedor;
  localStorage.setItem("sorteado", vencedor);

  alert("🎉 Número sorteado: " + vencedor);

  // destaca visualmente
  document.querySelectorAll(".numero").forEach(btn => {
    if (btn.textContent === vencedor) {
      btn.classList.add("vencedor");
    }
  });

}

<! FINAL DO CSS !>

.numero.vencedor {
  background: gold;
  color: black;
  font-weight: bold;
  transform: scale(1.1);
  border: 2px solid #fff;
}

<! FINAL HTML !>

<button onclick="sortearNumero()" style="margin:20px; padding:10px;">
  🎲 Sortear vencedor
</button>